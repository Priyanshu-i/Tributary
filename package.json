{
  "name": "tributary",
  "version": "1.0.0",
  "description": "Tributary: Your revenue-share agreement, now executable",
  "type": "module",
  "main": "src/server/index.ts",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "server": "tsx src/server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "vitest run src/core-engine/__tests__/amount-parser.test.ts",
    "smoke:paypal": "tsx scripts/smoke-test-paypal.ts",
    "eval:compile": "tsx scripts/run-compile-eval.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "paypal",
    "revenue-share",
    "hackathon",
    "smart-contracts",
    "ai",
    "payouts"
  ],
  "author": "Tributary Team",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@hono/node-server": "^1.13.7",
    "@paypal/paypal-server-sdk": "^2.5.0",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "hono": "^4.6.16",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "fast-check": "^3.23.2",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^3.0.4"
  }
}
