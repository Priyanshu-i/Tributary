# Tributary Environment Configuration (PayPal AI Hackathon)
# Operating Mode: Zero-Key Offline Mode supported out-of-the-box!

PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
DATABASE_URL=tributary.db

# PayPal Sandbox API Credentials
# Get these from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
VITE_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here

# PayPal Webhook ID (from PayPal Developer Dashboard webhook subscription)
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here

# Test Accounts (Sandbox personal US accounts recommended for instant claim)
PAYPAL_MERCHANT_EMAIL=sb-merchant@business.example.com
PAYPAL_SANDBOX_BUYER_EMAIL=sb-buyer@personal.example.com
PAYPAL_SANDBOX_BUYER_PASSWORD=sandbox_password

# 4 Payee Accounts for the Moonlit Indie Game Team Demo
PAYPAL_PAYEE_MAYA=sb-maya@personal.example.com
PAYPAL_PAYEE_ARJUN=sb-arjun@personal.example.com
PAYPAL_PAYEE_LINA=sb-lina@personal.example.com
PAYPAL_PAYEE_DEV=sb-dev@personal.example.com

# AI Compiler Configuration (Free Tier / Gemini 1.5 / 2.0 Flash)
# If GEMINI_API_KEY is not provided, Tributary automatically runs in OFFLINE_REPLAY_MODE
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=

# Replay Cache Settings
USE_REPLAY_CACHE=true
OFFLINE_REPLAY_ONLY=false
REPLAY_CACHE_PATH=fixtures/replay-cache.json

# Safety & Financial Guardrails
MAX_BATCH_PAYOUT_CENTS=1000000
FALLBACK_FEE_BPS=349
FALLBACK_FEE_FIXED_CENTS=49
